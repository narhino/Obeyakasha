# ── OBEY AKASHA — environment (PLAN §21) ─────────────────────────────────────
# Copy to .env and fill in. Optional vars can stay empty in early milestones.

# Core
NODE_ENV=development
APP_ORIGIN=http://localhost:3000                 # https://obeyakasha.com in prod
DATABASE_URL=postgres://postgres:postgres@localhost:5432/obeyakasha
AUTH_SECRET=                                     # `openssl rand -base64 32`

# Patreon (M0) — patreon.com/portal → Clients & API keys
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_CREATOR_ACCESS_TOKEN=                    # for reconcile/import jobs
PATREON_WEBHOOK_SECRET=
ADMIN_PATREON_USER_ID=                           # pins the goddess role to Akasha

# Web Push / VAPID (M2) — `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:akasha@obeyakasha.com

# Bunny storage + CDN (M1)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
BUNNY_CDN_HOST=
BUNNY_TOKEN_KEY=

# Transcriber sidecar (M3)
TRANSCRIBER_URL=http://localhost:8000
TRANSCRIBER_STUB=1                               # 1 = stub; 0 = real faster-whisper

# LLM providers (M3/M4) — per-task routing via the LLMProvider interface
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
LLM_TASK_ORGANIZE=anthropic
LLM_TASK_TRIAGE=anthropic
LLM_TASK_CLUSTER=anthropic
LLM_TASK_DRAFTS=anthropic

# Backups (M7)
BACKUP_AGE_RECIPIENT=

# Compose only
POSTGRES_PASSWORD=postgres
