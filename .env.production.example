# ── OBEY AKASHA — PRODUCTION environment ─────────────────────────────────────
# Copy to .env on your server, fill in the values, then run deploy/bootstrap.sh.
# Keep this file secret. Never commit your real .env.

# Your domain (no https://). DNS for this must point at THIS server's IP.
APP_DOMAIN=obeyakasha.com
# Full public URL (with https://). Usually just https:// + APP_DOMAIN.
APP_ORIGIN=https://obeyakasha.com

# Session signing secret. Generate a strong one:
#   openssl rand -base64 32
AUTH_SECRET=

# Database password (pick any strong string; it stays inside the server).
POSTGRES_PASSWORD=

# ── Patreon (required for sign-in) ───────────────────────────────────────────
# From patreon.com/portal → Clients & API Keys → your client.
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
# Optional but recommended (enables nightly membership reconciliation later):
PATREON_CREATOR_ACCESS_TOKEN=

# ── Make yourself admin ──────────────────────────────────────────────────────
# Easiest: the email on your Patreon account. Whoever signs in with this email
# becomes the goddess/admin. (Alternatively set ADMIN_PATREON_USER_ID.)
ADMIN_PATREON_EMAIL=
# ADMIN_PATREON_USER_ID=

# ── Media ────────────────────────────────────────────────────────────────────
# Leave Bunny blank to start (audio is stored on the server disk). To move to
# Bunny's CDN later, fill these in and redeploy — no code change.
# BUNNY_STORAGE_ZONE=
# BUNNY_STORAGE_KEY=
# BUNNY_CDN_HOST=
# BUNNY_TOKEN_KEY=

# ── Transcription (M3) — self-hosted Whisper, FREE, runs on this server ──────
# On by default. Model size: base (light) → small/medium (more accurate, more RAM).
TRANSCRIBER_STUB=0
WHISPER_MODEL=base
# Optional PAID alternative (more accurate, no server load): set this to use
# ElevenLabs Scribe instead of self-hosted Whisper (adapter added on request).
# ELEVENLABS_API_KEY=

# ── Organize + dossier analysis (M3 / v1.5 Phase D) ──────────────────────────
# The tag/trigger agent and the per-track dossier both work with NO key
# (heuristics from your titles + transcripts). Add an Anthropic key to deepen
# them (optional). LLM_ANALYZE_MODEL selects the heavy model for the dossier;
# set it to a current top-tier model id (ask me for the exact value).
# ANTHROPIC_API_KEY=
# LLM_ORGANIZE_MODEL=claude-sonnet-5
# LLM_ANALYZE_MODEL=

# ── Notifications (M2) — generate later with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:akasha@obeyakasha.com

# ── LLM (M3/M4) — add when those features go live ────────────────────────────
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
LLM_TASK_ORGANIZE=anthropic
LLM_TASK_TRIAGE=anthropic
LLM_TASK_CLUSTER=anthropic
LLM_TASK_DRAFTS=anthropic
